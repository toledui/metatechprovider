generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum UserStatus {
  INVITED
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  DISABLED
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum WhatsAppConnectionStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  ERROR
}

enum MetaTokenType {
  SHORT_LIVED
  LONG_LIVED
  SYSTEM_USER
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

enum WebhookSource {
  META
  API_GATEWAY
  CRM
  N8N
  INTERNAL
}

enum WebhookDeliveryStatus {
  RECEIVED
  PROCESSING
  SUCCEEDED
  FAILED
  IGNORED
}

enum DataDeletionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  INTERACTIVE
  LOCATION
  CONTACTS
  REACTION
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

model Tenant {
  id        BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId  String       @unique(map: "tenants_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  name      String       @db.VarChar(150)
  slug      String       @unique(map: "tenants_slug_key") @db.VarChar(160)
  status    TenantStatus @default(ONBOARDING)
  timezone  String       @default("UTC") @db.VarChar(64)
  settings  Json?
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime?    @map("deleted_at") @db.DateTime(3)

  users                   User[]
  whatsappConnections     WhatsAppConnection[]
  apiKeys                 ApiKey[]
  webhookLogs             WebhookLog[]
  dataDeletionRequests    DataDeletionRequest[]
  invitations             TenantInvitation[]
  auditLogs               AuditLog[]
  contacts                Contact[]
  conversations           Conversation[]
  messages                Message[]
  conversationAssignments ConversationAssignment[]
  tags                    Tag[]
  internalNotes           InternalNote[]
  inboxTeams              InboxTeam[]
  inboxTeamMemberships    InboxTeamMember[]
  whatsappTemplates       WhatsAppTemplate[]

  @@index([status, createdAt(sort: Desc)], map: "tenants_status_created_at_idx")
  @@map("tenants")
}

model User {
  id               BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String       @unique(map: "users_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId         BigInt       @map("tenant_id") @db.UnsignedBigInt
  name             String       @db.VarChar(150)
  email            String       @unique(map: "users_email_key") @db.VarChar(191)
  passwordHash     String       @map("password_hash") @db.VarChar(255)
  role             UserRole     @default(MEMBER)
  platformRole     PlatformRole @default(USER) @map("platform_role")
  status           UserStatus   @default(INVITED)
  lastLoginAt      DateTime?    @map("last_login_at") @db.DateTime(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt        DateTime?    @map("deleted_at") @db.DateTime(3)
  inboxPermissions Json?        @map("inbox_permissions")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdApiKeys          ApiKey[]                 @relation("ApiKeyCreatedBy")
  webhookLogs             WebhookLog[]             @relation("WebhookLogActor")
  sessions                Session[]
  tokens                  UserToken[]
  updatedPlatformSettings PlatformSetting[]        @relation("PlatformSettingUpdatedBy")
  sentInvitations         TenantInvitation[]       @relation("TenantInvitationInvitedBy")
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  assignedConversations   ConversationAssignment[] @relation("ConversationAssignedUser")
  conversationAssignments ConversationAssignment[] @relation("ConversationAssignedBy")
  sentMessages            Message[]                @relation("MessageSender")
  internalNotes           InternalNote[]
  inboxTeamMemberships    InboxTeamMember[]

  @@index([tenantId, status], map: "users_tenant_status_idx")
  @@index([platformRole, status], map: "users_platform_role_status_idx")
  @@map("users")
}

model TenantInvitation {
  id              BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String                 @unique(map: "tenant_invitations_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId        BigInt                 @map("tenant_id") @db.UnsignedBigInt
  invitedByUserId BigInt                 @map("invited_by_user_id") @db.UnsignedBigInt
  email           String                 @db.VarChar(191)
  role            UserRole               @default(MEMBER)
  tokenHash       String                 @unique(map: "tenant_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  status          TenantInvitationStatus @default(PENDING)
  expiresAt       DateTime               @map("expires_at") @db.DateTime(3)
  acceptedAt      DateTime?              @map("accepted_at") @db.DateTime(3)
  revokedAt       DateTime?              @map("revoked_at") @db.DateTime(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  invitedBy User   @relation("TenantInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, status, createdAt(sort: Desc)], map: "tenant_invitations_tenant_status_created_idx")
  @@index([tenantId, email, status], map: "tenant_invitations_tenant_email_status_idx")
  @@index([expiresAt, status], map: "tenant_invitations_expiry_status_idx")
  @@map("tenant_invitations")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String   @unique(map: "audit_logs_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  actorUserId    BigInt?  @map("actor_user_id") @db.UnsignedBigInt
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityPublicId String?  @map("entity_public_id") @db.VarChar(30)
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor  User?  @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, createdAt(sort: Desc)], map: "audit_logs_tenant_created_at_idx")
  @@index([tenantId, action, createdAt(sort: Desc)], map: "audit_logs_tenant_action_created_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_created_at_idx")
  @@map("audit_logs")
}

model UserToken {
  id         BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt        @map("user_id") @db.UnsignedBigInt
  type       UserTokenType
  tokenHash  String        @unique(map: "user_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at") @db.DateTime(3)
  consumedAt DateTime?     @map("consumed_at") @db.DateTime(3)
  requestIp  String?       @map("request_ip") @db.VarChar(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, type, consumedAt], map: "user_tokens_user_type_consumed_idx")
  @@index([expiresAt], map: "user_tokens_expires_at_idx")
  @@map("user_tokens")
}

model PlatformSetting {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  provider        String   @unique(map: "platform_settings_provider_key") @db.VarChar(50)
  configEncrypted String   @map("config_encrypted") @db.Text
  enabled         Boolean  @default(false)
  version         Int      @default(1) @db.UnsignedInt
  updatedByUserId BigInt?  @map("updated_by_user_id") @db.UnsignedBigInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  updatedBy User? @relation("PlatformSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([enabled, updatedAt(sort: Desc)], map: "platform_settings_enabled_updated_idx")
  @@map("platform_settings")
}

model Session {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenHash  String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  userId     BigInt    @map("user_id") @db.UnsignedBigInt
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.DateTime(3)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt], map: "sessions_user_revoked_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model WhatsAppConnection {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId               String                   @unique(map: "wa_connections_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId               BigInt                   @map("tenant_id") @db.UnsignedBigInt
  wabaId                 String                   @map("waba_id") @db.VarChar(64)
  phoneNumberId          String                   @unique(map: "wa_connections_phone_number_id_key") @map("phone_number_id") @db.VarChar(64)
  displayPhoneNumber     String?                  @map("display_phone_number") @db.VarChar(32)
  verifiedName           String?                  @map("verified_name") @db.VarChar(255)
  accessTokenEncrypted   String                   @map("access_token_encrypted") @db.Text
  tokenType              MetaTokenType            @default(SHORT_LIVED) @map("token_type")
  tokenExpiresAt         DateTime?                @map("token_expires_at") @db.DateTime(3)
  status                 WhatsAppConnectionStatus @default(PENDING)
  webhookUrl             String?                  @map("webhook_url") @db.VarChar(2048)
  webhookSecretEncrypted String?                  @map("webhook_secret_encrypted") @db.Text
  coexistenceEnabled     Boolean                  @default(false) @map("coexistence_enabled")
  metaBusinessId         String?                  @map("meta_business_id") @db.VarChar(64)
  metaUserId             String?                  @map("meta_user_id") @db.VarChar(64)
  metadata               Json?
  connectedAt            DateTime?                @map("connected_at") @db.DateTime(3)
  lastWebhookAt          DateTime?                @map("last_webhook_at") @db.DateTime(3)
  lastErrorAt            DateTime?                @map("last_error_at") @db.DateTime(3)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt              DateTime?                @map("deleted_at") @db.DateTime(3)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  webhookLogs   WebhookLog[]
  conversations Conversation[]
  messages      Message[]
  templates     WhatsAppTemplate[]

  @@index([tenantId, status], map: "wa_connections_tenant_status_idx")
  @@index([tenantId, wabaId], map: "wa_connections_tenant_waba_idx")
  @@index([tenantId, createdAt(sort: Desc)], map: "wa_connections_tenant_created_at_idx")
  @@index([metaUserId], map: "wa_connections_meta_user_id_idx")
  @@map("whatsapp_connections")
}

model DataDeletionRequest {
  id                   BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId             String             @unique(map: "data_deletion_requests_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId             BigInt?            @map("tenant_id") @db.UnsignedBigInt
  requestHash          String             @unique(map: "data_deletion_requests_request_hash_key") @map("request_hash") @db.Char(64)
  confirmationCodeHash String             @unique(map: "data_deletion_requests_confirmation_code_hash_key") @map("confirmation_code_hash") @db.Char(64)
  metaUserIdHash       String             @map("meta_user_id_hash") @db.Char(64)
  status               DataDeletionStatus @default(PENDING)
  affectedConnections  Int                @default(0) @map("affected_connections") @db.UnsignedInt
  requestedAt          DateTime           @default(now()) @map("requested_at") @db.DateTime(3)
  completedAt          DateTime?          @map("completed_at") @db.DateTime(3)
  errorMessage         String?            @map("error_message") @db.Text

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, requestedAt(sort: Desc)], map: "data_deletion_requests_status_requested_idx")
  @@index([metaUserIdHash, requestedAt(sort: Desc)], map: "data_deletion_requests_meta_user_requested_idx")
  @@map("data_deletion_requests")
}

model ApiKey {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String       @unique(map: "api_keys_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId        BigInt       @map("tenant_id") @db.UnsignedBigInt
  createdByUserId BigInt?      @map("created_by_user_id") @db.UnsignedBigInt
  name            String       @db.VarChar(100)
  keyPrefix       String       @map("key_prefix") @db.VarChar(16)
  keyHash         String       @unique(map: "api_keys_key_hash_key") @map("key_hash") @db.Char(64)
  lastFour        String       @map("last_four") @db.Char(4)
  scopes          Json
  status          ApiKeyStatus @default(ACTIVE)
  lastUsedAt      DateTime?    @map("last_used_at") @db.DateTime(3)
  expiresAt       DateTime?    @map("expires_at") @db.DateTime(3)
  revokedAt       DateTime?    @map("revoked_at") @db.DateTime(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy   User?        @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  webhookLogs WebhookLog[]

  @@index([tenantId, status], map: "api_keys_tenant_status_idx")
  @@index([tenantId, createdAt(sort: Desc)], map: "api_keys_tenant_created_at_idx")
  @@index([expiresAt], map: "api_keys_expires_at_idx")
  @@map("api_keys")
}

model WebhookLog {
  id               BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String                @unique(map: "webhook_logs_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId         BigInt?               @map("tenant_id") @db.UnsignedBigInt
  connectionId     BigInt?               @map("connection_id") @db.UnsignedBigInt
  apiKeyId         BigInt?               @map("api_key_id") @db.UnsignedBigInt
  actorUserId      BigInt?               @map("actor_user_id") @db.UnsignedBigInt
  direction        WebhookDirection
  source           WebhookSource
  eventType        String                @map("event_type") @db.VarChar(100)
  externalEventId  String?               @map("external_event_id") @db.VarChar(191)
  deduplicationKey String?               @unique(map: "webhook_logs_deduplication_key") @map("deduplication_key") @db.Char(64)
  status           WebhookDeliveryStatus @default(RECEIVED)
  targetUrl        String?               @map("target_url") @db.VarChar(2048)
  requestPayload   Json                  @map("request_payload")
  responsePayload  Json?                 @map("response_payload")
  httpStatus       Int?                  @map("http_status") @db.UnsignedSmallInt
  attemptCount     Int                   @default(0) @map("attempt_count") @db.UnsignedSmallInt
  durationMs       Int?                  @map("duration_ms") @db.UnsignedInt
  errorMessage     String?               @map("error_message") @db.Text
  receivedAt       DateTime              @default(now()) @map("received_at") @db.DateTime(3)
  processedAt      DateTime?             @map("processed_at") @db.DateTime(3)
  nextRetryAt      DateTime?             @map("next_retry_at") @db.DateTime(3)

  tenant     Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  connection WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  apiKey     ApiKey?             @relation(fields: [apiKeyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorUser  User?               @relation("WebhookLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, receivedAt(sort: Desc)], map: "webhook_logs_tenant_received_at_idx")
  @@index([connectionId, receivedAt(sort: Desc)], map: "webhook_logs_connection_received_at_idx")
  @@index([apiKeyId, receivedAt(sort: Desc)], map: "webhook_logs_api_key_received_at_idx")
  @@index([status, nextRetryAt], map: "webhook_logs_status_retry_idx")
  @@index([direction, receivedAt(sort: Desc)], map: "webhook_logs_direction_received_at_idx")
  @@index([externalEventId], map: "webhook_logs_external_event_id_idx")
  @@map("webhook_logs")
}

model Contact {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String   @unique(map: "contacts_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId    BigInt   @map("tenant_id") @db.UnsignedBigInt
  waId        String   @map("wa_id") @db.VarChar(32)
  name        String?  @db.VarChar(191)
  profileName String?  @map("profile_name") @db.VarChar(191)
  email       String?  @db.VarChar(191)
  company     String?  @db.VarChar(191)
  notes       String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversations Conversation[]

  @@unique([tenantId, waId], map: "contacts_tenant_wa_id_key")
  @@index([tenantId, name], map: "contacts_tenant_name_idx")
  @@map("contacts")
}

model Conversation {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  publicId           String             @unique(map: "conversations_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId           BigInt             @map("tenant_id") @db.UnsignedBigInt
  contactId          BigInt             @map("contact_id") @db.UnsignedBigInt
  connectionId       BigInt             @map("connection_id") @db.UnsignedBigInt
  status             ConversationStatus @default(OPEN)
  subject            String?            @db.VarChar(191)
  lastMessageAt      DateTime?          @map("last_message_at") @db.DateTime(3)
  lastInboundAt      DateTime?          @map("last_inbound_at") @db.DateTime(3)
  lastOutboundAt     DateTime?          @map("last_outbound_at") @db.DateTime(3)
  lastMessagePreview String?            @map("last_message_preview") @db.VarChar(500)
  unreadCount        Int                @default(0) @map("unread_count") @db.UnsignedInt
  resolvedAt         DateTime?          @map("resolved_at") @db.DateTime(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact       Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection    WhatsAppConnection       @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages      Message[]
  assignments   ConversationAssignment[]
  tags          Tag[]
  internalNotes InternalNote[]

  @@unique([contactId, connectionId], map: "conversations_contact_connection_key")
  @@index([tenantId, status, lastMessageAt(sort: Desc)], map: "conversations_tenant_status_last_message_idx")
  @@index([tenantId, unreadCount, lastMessageAt(sort: Desc)], map: "conversations_tenant_unread_last_message_idx")
  @@map("conversations")
}

model Message {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String           @unique(map: "messages_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId         BigInt           @map("tenant_id") @db.UnsignedBigInt
  conversationId   BigInt           @map("conversation_id") @db.UnsignedBigInt
  connectionId     BigInt           @map("connection_id") @db.UnsignedBigInt
  senderUserId     BigInt?          @map("sender_user_id") @db.UnsignedBigInt
  externalId       String?          @unique(map: "messages_external_id_key") @map("external_id") @db.VarChar(191)
  direction        MessageDirection
  type             MessageType
  status           MessageStatus
  textBody         String?          @map("text_body") @db.Text
  content          Json
  errorCode        String?          @map("error_code") @db.VarChar(100)
  errorMessage     String?          @map("error_message") @db.Text
  sentAt           DateTime?        @map("sent_at") @db.DateTime(3)
  deliveredAt      DateTime?        @map("delivered_at") @db.DateTime(3)
  readAt           DateTime?        @map("read_at") @db.DateTime(3)
  failedAt         DateTime?        @map("failed_at") @db.DateTime(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  retryOfMessageId BigInt?          @map("retry_of_message_id") @db.UnsignedBigInt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection   WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  senderUser   User?              @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  retryOf      Message?           @relation("MessageRetries", fields: [retryOfMessageId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  retries      Message[]          @relation("MessageRetries")

  @@index([conversationId, createdAt], map: "messages_conversation_created_idx")
  @@index([tenantId, status, updatedAt(sort: Desc)], map: "messages_tenant_status_updated_idx")
  @@index([retryOfMessageId], map: "messages_retry_of_idx")
  @@map("messages")
}

model ConversationAssignment {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId         String    @unique(map: "conversation_assignments_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId         BigInt    @map("tenant_id") @db.UnsignedBigInt
  conversationId   BigInt    @map("conversation_id") @db.UnsignedBigInt
  assignedUserId   BigInt?   @map("assigned_user_id") @db.UnsignedBigInt
  teamName         String?   @map("team_name") @db.VarChar(100)
  teamId           BigInt?   @map("team_id") @db.UnsignedBigInt
  assignedByUserId BigInt    @map("assigned_by_user_id") @db.UnsignedBigInt
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  endedAt          DateTime? @map("ended_at") @db.DateTime(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedUser User?        @relation("ConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedBy   User         @relation("ConversationAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  team         InboxTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([conversationId, endedAt, createdAt(sort: Desc)], map: "conversation_assignments_active_idx")
  @@index([tenantId, assignedUserId, endedAt], map: "conversation_assignments_user_active_idx")
  @@index([tenantId, teamName, endedAt], map: "conversation_assignments_team_active_idx")
  @@index([tenantId, teamId, endedAt], map: "conversation_assignments_team_id_active_idx")
  @@map("conversation_assignments")
}

model Tag {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId  String   @unique(map: "tags_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  name      String   @db.VarChar(80)
  color     String   @default("#ff6b35") @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversations Conversation[]

  @@unique([tenantId, name], map: "tags_tenant_name_key")
  @@index([tenantId, createdAt], map: "tags_tenant_created_idx")
  @@map("tags")
}

model InternalNote {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String   @unique(map: "internal_notes_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  conversationId BigInt   @map("conversation_id") @db.UnsignedBigInt
  authorUserId   BigInt   @map("author_user_id") @db.UnsignedBigInt
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author       User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([conversationId, createdAt], map: "internal_notes_conversation_created_idx")
  @@map("internal_notes")
}

model InboxTeam {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId  String   @unique(map: "inbox_teams_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  name      String   @db.VarChar(100)
  color     String   @default("#ff6b35") @db.Char(7)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  members     InboxTeamMember[]
  assignments ConversationAssignment[]

  @@unique([tenantId, name], map: "inbox_teams_tenant_name_key")
  @@index([tenantId, createdAt], map: "inbox_teams_tenant_created_idx")
  @@map("inbox_teams")
}

model InboxTeamMember {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  teamId    BigInt   @map("team_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team   InboxTeam @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([teamId, userId], map: "inbox_team_members_team_user_key")
  @@index([tenantId, userId], map: "inbox_team_members_tenant_user_idx")
  @@map("inbox_team_members")
}

model WhatsAppTemplate {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String   @unique(map: "wa_templates_public_id_key") @default(cuid()) @map("public_id") @db.VarChar(30)
  tenantId        BigInt   @map("tenant_id") @db.UnsignedBigInt
  connectionId    BigInt   @map("connection_id") @db.UnsignedBigInt
  metaTemplateId  String?  @map("meta_template_id") @db.VarChar(64)
  name            String   @db.VarChar(512)
  language        String   @db.VarChar(35)
  category        String   @db.VarChar(40)
  status          String   @default("PENDING") @db.VarChar(40)
  qualityScore    String?  @map("quality_score") @db.VarChar(40)
  rejectionReason String?  @map("rejection_reason") @db.Text
  components      Json
  rawPayload      Json?    @map("raw_payload")
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.DateTime(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([connectionId, name, language], map: "wa_templates_connection_name_language_key")
  @@index([tenantId, status, updatedAt(sort: Desc)], map: "wa_templates_tenant_status_updated_idx")
  @@index([connectionId, metaTemplateId], map: "wa_templates_connection_meta_id_idx")
  @@map("whatsapp_templates")
}
